// Danets AI Automation - Multi-tenant SaaS schema
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy & Auth ────────────────────────────────────────────────

model Business {
  id               String    @id @default(cuid())
  name             String
  publicKey        String    @unique @default(cuid())
  industry         String?
  email            String?
  phone            String?
  whatsapp         String?
  plan             String    @default("free") // free | starter | pro | enterprise
  status           String    @default("active") // active | suspended | deleted
  enforce2fa       Boolean   @default(false) // require 2FA for all members of this business
  deletedAt        DateTime?
  purgeScheduledAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  users                BusinessUser[]
  aiAgents             AiAgent[]
  knowledgeBaseItems   KnowledgeBaseItem[]
  chatSessions         ChatSession[]
  leads                Lead[]
  promptTemplates      AiPromptTemplate[]
  quoteRequests        QuoteRequest[]
  generatedDocuments   GeneratedDocument[]
  usageLogs            AiUsageLog[]
  sessions             Session[]
  ticketCategories     SupportTicketCategory[]
  supportTickets       SupportTicket[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  documents            Document[]
  whatsappTemplates    WhatsAppTemplate[]
  whatsappIntegration  WhatsAppIntegration[]
  automationWorkflows  AutomationWorkflow[]
  integrations         Integration[]
  oauthConnections     OAuthConnection[]
  contacts             Contact[]
  touchpoints          Touchpoint[]
  brandProfile         BrandProfile?
  socialAccounts       SocialAccount[]
  metaLeadForms        MetaLeadForm[]
  mediaAssets          MediaAsset[]
  subscription         BusinessSubscription?
  payments             Payment[]
  invoices             Invoice[]
  whatsappMessages     WhatsAppMessage[]
  whiteLabel           WhiteLabelConfig?
  featureFlagOverrides BusinessFeatureFlag[]
  limitOverride        BusinessLimitOverride?

  @@index([purgeScheduledAt])
}

model BusinessUser {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  email           String   @unique
  password        String // bcrypt hash
  role            String   @default("admin") // admin | member
  isSuperAdmin    Boolean  @default(false) // Danets TecPro internal super admin
  totpSecret      String? // base32 secret when 2FA enabled
  totpPending     String? // pending secret during setup
  totpEnabled     Boolean  @default(false)
  totpBackupCodes Json? // SHA-256 hashes of one-time backup codes (array of strings)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([businessId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  businessId String
  tokenHash  String    @unique // SHA-256 of the cleartext token sent in the email
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user BusinessUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id                String    @id @default(cuid())
  token             String    @unique
  csrfToken         String?   @unique
  businessUserId    String
  businessId        String
  expiresAt         DateTime
  /// Hard cap — session is rejected once we are past this, regardless of activity.
  /// Set equal to `expiresAt` at creation; the sliding window lives on `lastSeenAt`.
  absoluteExpiresAt DateTime
  /// Last time `requireSession` validated this session. Used for the idle timeout.
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())

  businessUser BusinessUser @relation(fields: [businessUserId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([token])
  @@index([absoluteExpiresAt])
}

// ─── AI Configuration ──────────────────────────────────────────────

model AiAgent {
  id                 String   @id @default(cuid())
  businessId         String
  botName            String   @default("Assistant")
  businessName       String?
  industry           String?
  welcomeMessage     String   @default("Hi! How can I help you today?")
  fallbackMessage    String   @default("I'm not fully sure about that. Please contact our team for confirmation.")
  handoverMessage    String   @default("Let me connect you with our team for further assistance.")
  tone               String   @default("professional") // professional | friendly | formal
  contactPhone       String?
  whatsappNumber     String?
  email              String?
  brandColor         String   @default("#1d4ed8")
  quickReplies       String   @default("[]") // JSON array of suggested question strings
  status             String   @default("active") // active | inactive
  leadCaptureEnabled Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]

  @@index([businessId])
}

model KnowledgeBaseItem {
  id         String   @id @default(cuid())
  businessId String
  title      String
  content    String
  category   String   @default("General")
  sourceType String   @default("manual") // manual | faq | doc | url
  status     String   @default("active") // active | draft | archived
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
}

model AiPromptTemplate {
  id         String   @id @default(cuid())
  businessId String
  name       String
  type       String   @default("custom") // chat_system | suggested_reply | quote | summary | custom
  content    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── Chat & Leads ──────────────────────────────────────────────────

model ChatSession {
  id           String   @id @default(cuid())
  businessId   String
  agentId      String?
  visitorName  String?
  visitorEmail String?
  visitorPhone String?
  visitorId    String? // anonymous browser id
  contactId    String?
  status       String   @default("active") // active | ended | handover
  summary      String?  @db.Text
  leadQuality  String? // low | medium | high
  nextAction   String?  @db.Text
  // Social inbox (Phase 1 H). Widget chats keep the defaults.
  channel          String         @default("widget") // widget | messenger | instagram_dm | facebook_comment | instagram_comment
  socialAccountId  String?
  externalThreadId String?        @db.VarChar(191) // PSID / IGSID for DMs, root comment id for comment threads
  threadMeta       Json? // comment threads: { postId, mediaId, permalink, postText }
  lastInboundAt    DateTime? // drives Meta's 24-hour messaging window
  autoReplyPaused  Boolean        @default(false) // a human took over
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agent          AiAgent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  socialAccount  SocialAccount?  @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  messages       ChatMessage[]
  lead           Lead?
  supportTickets SupportTicket[]

  @@unique([socialAccountId, externalThreadId])
  @@index([businessId])
  @@index([status])
  @@index([contactId])
  @@index([businessId, visitorId])
  @@index([businessId, channel, updatedAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  sessionId      String
  role           String // user | assistant | system ("assistant" with sentByUserId = a team member)
  content        String   @db.Text
  tokensUsed     Int      @default(0)
  meta           String?  @db.Text // JSON string for extra data
  // Social inbox (Phase 1 H)
  externalId     String?  @unique @db.VarChar(191) // Meta message mid / comment id, for dedupe
  deliveryStatus String? // sent | failed (outbound social messages)
  sentByUserId   String? // BusinessUser who sent it; null = AI or the visitor
  createdAt      DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Lead {
  id                String    @id @default(cuid())
  businessId        String
  sessionId         String?   @unique
  name              String
  email             String?
  phone             String?
  service           String?
  message           String?   @db.Text
  quality           String    @default("medium") // low | medium | high
  status            String    @default("new") // new | contacted | qualified | proposal_sent | negotiation | won | lost
  source            String    @default("chatbot") // chatbot | website_form | manual | whatsapp | referral | social_media, or an attribution channel: organic_search | paid_search | social_organic | social_paid | email | direct (see src/lib/attribution.ts)
  // CRM fields
  dealValue         Float     @default(0)
  leadScore         Int       @default(0) // 0-100
  expectedCloseDate DateTime?
  assignedTo        String? // BusinessUser id
  company           String?
  // Attribution (Phase 0 D): the unified Contact and the touchpoints that
  // produced this lead. Touch ids are plain columns (no FK) so pruning a
  // touchpoint never blocks or cascades into a lead.
  contactId         String?
  firstTouchId      String?
  lastTouchId       String?
  // Id in the system the lead was imported from, e.g. "meta:<leadgen_id>".
  // Unique per business so webhook retries and pollers never duplicate a lead.
  externalRef       String?   @db.VarChar(191)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  session    ChatSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes      LeadNote[]
  tasks      LeadTask[]
  activities LeadActivity[]

  // Dedupe within a tenant: a given email can only create one Lead per
  // Business. MySQL allows multiple NULL emails in a unique index, so
  // anonymous leads (no email collected) are unaffected. Pair-indexed
  // for query speed on the public widget's pre-submit dedupe lookup.
  @@unique([businessId, email], name: "Lead_businessId_email_key")
  @@unique([businessId, externalRef])
  @@index([businessId])
  @@index([status])
  @@index([assignedTo])
  @@index([contactId])
}

// ─── CRM: Lead Notes, Tasks, Activities ───────────────────────────

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  businessId String
  authorId   String? // BusinessUser id
  authorName String
  content    String
  createdAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([businessId])
}

model LeadTask {
  id          String    @id @default(cuid())
  leadId      String
  businessId  String
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  assigneeId  String? // BusinessUser id
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([businessId])
  @@index([completed])
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  businessId  String
  type        String // status_change | note_added | task_created | task_completed | lead_created | lead_updated | call | email | whatsapp
  description String
  metadata    String? // JSON string for extra context
  actorId     String? // BusinessUser id (null for system)
  actorName   String?
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([businessId])
  @@index([type])
}

// ─── Support Tickets ───────────────────────────────────────────────

model SupportTicketCategory {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  color       String   @default("#1d4ed8")
  createdAt   DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tickets  SupportTicket[]

  @@index([businessId])
}

model SupportTicket {
  id               String    @id @default(cuid())
  businessId       String
  categoryId       String?
  chatSessionId    String? // link to chat session if converted from chat
  subject          String
  description      String
  status           String    @default("open") // open | pending | in_progress | resolved | closed
  priority         String    @default("medium") // low | medium | high | urgent
  // AI-detected fields
  aiSummary        String?
  aiPriority       String? // low | medium | high | urgent
  aiSentiment      String? // positive | neutral | negative | frustrated
  aiNextAction     String?
  // Customer info
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  contactId        String?
  // Assignment
  assignedTo       String? // BusinessUser id
  assignedName     String?
  // AI suggested reply (stored for review, not auto-sent)
  aiSuggestedReply String?
  // Timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  resolvedAt       DateTime?

  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    SupportTicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  chatSession ChatSession?           @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  contact     Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages    SupportTicketMessage[]
  notes       SupportTicketNote[]

  @@index([businessId])
  @@index([status])
  @@index([priority])
  @@index([contactId])
}

model SupportTicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  role       String // customer | agent | system
  content    String
  authorId   String? // BusinessUser id (for agent messages)
  authorName String?
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SupportTicketNote {
  id         String   @id @default(cuid())
  ticketId   String
  businessId String
  authorId   String?
  authorName String
  content    String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([businessId])
}

// ─── Usage & Documents ─────────────────────────────────────────────

model AiUsageLog {
  id               String   @id @default(cuid())
  businessId       String
  feature          String // chat | suggested_reply | quote | summary | lead_scoring
  provider         String   @default("zai") // anthropic | openai | zai
  model            String?
  promptTokens     Int      @default(0) // all input tokens, including cache reads/writes
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  latencyMs        Int?
  costUsd          Float    @default(0)
  status           String   @default("success") // success | error
  error            String?
  createdAt        DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([feature])
}

model QuoteRequest {
  id              String    @id @default(cuid())
  businessId      String
  clientName      String
  companyName     String?
  contactId       String?
  service         String
  requirements    String
  budgetRange     String?
  timeline        String?
  notes           String?
  status          String    @default("draft") // draft | generated | sent | viewed | accepted | rejected
  // Pricing fields
  subtotal        Float     @default(0)
  discount        Float     @default(0) // percentage or flat amount
  discountType    String    @default("percentage") // percentage | flat
  taxRate         Float     @default(0) // percentage
  taxAmount       Float     @default(0)
  total           Float     @default(0)
  currency        String    @default("USD")
  // Acceptance
  acceptedAt      DateTime?
  acceptedByName  String?
  acceptedByEmail String?
  clientFeedback  String?
  // Template
  templateId      String?
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact   Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  documents GeneratedDocument[]
  items     ProposalItem[]
  followups ProposalFollowup[]

  @@index([businessId])
  @@index([status])
  @@index([contactId])
}

// ─── Proposal Templates & Items ───────────────────────────────────

model ProposalTemplate {
  id           String   @id @default(cuid())
  businessId   String? // null = global template, set = business-specific
  name         String
  type         String // website_dev | software_dev | ai_chatbot | cloud_hosting | cybersecurity_audit | website_maintenance | isp_software | construction_erp | custom
  industry     String?
  description  String?
  sections     String   @default("[]") // JSON array of section names
  defaultItems String   @default("[]") // JSON array of { description, quantity, unitPrice }
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
  @@index([type])
}

model ProposalItem {
  id             String   @id @default(cuid())
  quoteRequestId String
  description    String
  quantity       Int      @default(1)
  unitPrice      Float    @default(0)
  total          Float    @default(0)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
}

model ProposalFollowup {
  id             String    @id @default(cuid())
  quoteRequestId String
  businessId     String
  type           String // email | whatsapp | call | note
  content        String
  scheduledFor   DateTime?
  completedAt    DateTime?
  createdBy      String?
  createdByName  String?
  createdAt      DateTime  @default(now())

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
  @@index([businessId])
}

model GeneratedDocument {
  id             String   @id @default(cuid())
  businessId     String
  quoteRequestId String?
  type           String   @default("proposal") // proposal | summary | quote
  title          String
  content        String
  createdAt      DateTime @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)

  @@index([businessId])
}

model SubscriptionPlan {
  id                    String   @id @default(cuid())
  name                  String   @unique
  priceUsd              Float    @default(0)
  chatLimit             Int      @default(100)
  leadLimit             Int      @default(50)
  kbLimit               Int      @default(25)
  agentLimit            Int      @default(1)
  ticketLimit           Int      @default(100)
  documentLimit         Int      @default(25)
  automationLimit       Int      @default(5)
  seatLimit             Int      @default(3)
  whatsappTemplateLimit Int      @default(5)
  integrationLimit      Int      @default(3)
  proposalTemplateLimit Int      @default(10)
  quoteLimit            Int      @default(50)
  mediaStorageMbLimit   Int      @default(1024) // media library, in MB (0 = unlimited)
  auditRetentionDays    Int      @default(30)
  chatRetentionDays     Int      @default(90)
  leadRetentionDays     Int      @default(365)
  features              String   @default("[]") // JSON array
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model BusinessLimitOverride {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  chatLimit             Int?
  leadLimit             Int?
  kbLimit               Int?
  agentLimit            Int?
  ticketLimit           Int?
  documentLimit         Int?
  automationLimit       Int?
  seatLimit             Int?
  whatsappTemplateLimit Int?
  integrationLimit      Int?
  proposalTemplateLimit Int?
  quoteLimit            Int?
  mediaStorageMbLimit   Int?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── Notifications ─────────────────────────────────────────────────

model Notification {
  id         String    @id @default(cuid())
  businessId String
  userId     String? // targeted user (null = all business users)
  type       String // new_lead | new_ticket | urgent_ticket | proposal_generated | proposal_accepted | follow_up_reminder | high_quality_lead | ai_usage_warning | subscription_expiry | integration_failed | new_chat_session
  title      String
  message    String
  data       String? // JSON string for extra context (leadId, ticketId, etc.)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([type])
  @@index([readAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  businessId  String
  userId      String?
  userName    String?
  action      String // login | user_created | user_updated | user_deleted | business_settings_changed | ai_agent_updated | kb_updated | lead_status_changed | proposal_generated | ticket_updated | document_uploaded | integration_changed | subscription_changed
  module      String // auth | team | business | agent | knowledge | leads | quotes | tickets | documents | integrations | subscription
  description String
  ipAddress   String?
  userAgent   String?
  metadata    String? // JSON string for extra context
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([action])
  @@index([module])
}

model NotificationPreference {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  type       String // matches Notification.type
  inApp      Boolean  @default(true)
  email      Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, userId, type])
  @@index([businessId, userId])
}

// ─── AI Document Assistant ────────────────────────────────────────

model Document {
  id         String   @id @default(cuid())
  businessId String
  title      String
  category   String   @default("General")
  sourceType String   @default("text") // text | pdf | docx | txt
  content    String // full text content (for text-based docs) or extracted text
  fileName   String? // original file name if uploaded
  fileSize   Int? // bytes
  summary    String? // AI-generated summary
  status     String   @default("active") // active | processing | archived
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]
  questions DocumentAiQuestion[]

  @@index([businessId])
  @@index([status])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentAiQuestion {
  id         String   @id @default(cuid())
  documentId String
  businessId String
  question   String
  answer     String?
  tokensUsed Int      @default(0)
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([businessId])
}

// ─── WhatsApp Automation ──────────────────────────────────────────

model WhatsAppTemplate {
  id         String   @id @default(cuid())
  businessId String
  name       String
  type       String // new_lead_followup | missed_chat | quotation_followup | payment_reminder | appointment_confirmation | ticket_update | custom
  content    String // template text with {name}, {service}, {company} placeholders
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([type])
}

model WhatsAppIntegration {
  id            String    @id @default(cuid())
  businessId    String
  provider      String    @default("manual") // manual | meta_cloud_api | twilio | termii | other
  phoneNumber   String?
  phoneNumberId String? // Meta Cloud API phone number ID
  apiKey        String? // stored server-side only, never exposed to frontend
  webhookUrl    String?
  status        String    @default("inactive") // active | inactive | testing
  lastTestedAt  DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── Automation Workflows ─────────────────────────────────────────

model AutomationWorkflow {
  id            String    @id @default(cuid())
  businessId    String
  name          String
  description   String?
  triggerType   String // new_lead | new_ticket | proposal_generated | proposal_accepted | lead_status_changed | document_uploaded | no_response_days
  triggerConfig String? // JSON: { days?: number, leadStatus?: string }
  actionType    String // create_task | send_notification | generate_ai_followup | add_lead_note | change_lead_status | create_ticket | create_proposal_reminder
  actionConfig  String? // JSON: { taskTitle?, noteContent?, leadStatus?, notificationType? }
  isActive      Boolean   @default(true)
  runCount      Int       @default(0)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  runs     AutomationRun[]

  @@index([businessId])
  @@index([triggerType])
  @@index([isActive])
}

model AutomationRun {
  id          String   @id @default(cuid())
  workflowId  String
  businessId  String
  triggerData String? // JSON: what triggered this run
  actionData  String? // JSON: what action was taken
  status      String   @default("success") // success | error
  error       String?
  createdAt   DateTime @default(now())

  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([businessId])
}

// ─── Integrations ─────────────────────────────────────────────────

// OAuth-connected third-party accounts (Meta, Google, …). Tokens are
// AES-256-GCM envelopes from src/lib/crypto.ts; never return them to clients.
model OAuthConnection {
  id                String    @id @default(cuid())
  businessId        String
  provider          String // meta | google
  externalAccountId String // provider's user/account id
  accountName       String?
  accountEmail      String?
  scopes            String    @db.Text // space-separated granted scopes
  accessToken       Json // EncryptedPayload
  refreshToken      Json? // EncryptedPayload
  expiresAt         DateTime?
  status            String    @default("active") // active | expired | revoked | error
  lastError         String?   @db.Text
  lastRefreshedAt   DateTime?
  // Provider extras, e.g. Meta pages (with encrypted page tokens), GSC properties
  metadata          Json?
  connectedById     String? // BusinessUser id
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccounts SocialAccount[]

  @@unique([businessId, provider, externalAccountId])
  @@index([businessId])
  @@index([status, expiresAt])
}

model Integration {
  id           String    @id @default(cuid())
  businessId   String
  category     String // ai_provider | whatsapp | email | sms | payment | crm | website_widget
  provider     String // e.g. openai, zai, meta, twilio, sendgrid, paystack, flutterwave, manual
  name         String // display name
  status       String    @default("inactive") // active | inactive | testing | error
  config       String? // JSON: provider-specific config (apiKey masked in frontend)
  lastTestedAt DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([category])
}

// ─── Subscription Management ──────────────────────────────────────

model BusinessSubscription {
  id                    String    @id @default(cuid())
  businessId            String    @unique
  planName              String // free | starter | business | premium | enterprise
  status                String    @default("active") // active | trial | past_due | canceled | expired
  startDate             DateTime  @default(now())
  endDate               DateTime?
  trialEndsAt           DateTime?
  monthlyFee            Float     @default(0)
  paymentMethod         String? // paystack | flutterwave | bank_transfer | manual
  paymentRef            String? // transaction reference
  downgradeScheduledFor DateTime? // when a scheduled downgrade takes effect
  downgradeTargetPlan   String? // target plan for the scheduled downgrade
  metadata              Json? // free-form JSON for additional transition state
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments Payment[]
  invoices Invoice[]

  @@index([status])
}

// ─── Payments & Invoices ──────────────────────────────────────────

model Payment {
  id             String    @id @default(cuid())
  businessId     String
  subscriptionId String?
  amount         Float
  currency       String    @default("USD")
  provider       String // paystack | flutterwave | bank_transfer | manual
  reference      String    @unique // unique transaction reference
  status         String    @default("pending") // pending | success | failed | refunded
  providerRef    String? // provider's transaction reference
  payerEmail     String?
  payerName      String?
  metadata       String? // JSON for extra data
  paidAt         DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription BusinessSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice      Invoice?

  @@index([businessId])
  @@index([status])
  @@index([reference])
}

// Login attempt tracking. Per-IP and per-email rate limiting + account
// lockout for /api/auth/login. The IP and email indexes make the per-pair
// count query O(log n) without scanning the full table.
model LoginAttempt {
  id          String   @id @default(cuid())
  ip          String
  email       String
  businessId  String?
  succeeded   Boolean  @default(false)
  userAgent   String?
  attemptedAt DateTime @default(now())

  @@index([ip, attemptedAt])
  @@index([email, attemptedAt])
  @@index([attemptedAt])
}

model Invoice {
  id             String    @id @default(cuid())
  businessId     String
  subscriptionId String?
  paymentId      String?   @unique
  invoiceNumber  String    @unique
  amount         Float
  currency       String    @default("USD")
  status         String    @default("draft") // draft | sent | paid | void | overdue
  dueDate        DateTime?
  paidAt         DateTime?
  items          String    @default("[]") // JSON array of { description, quantity, unitPrice, total }
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription BusinessSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payment      Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([status])
  @@index([invoiceNumber])
}

// ─── WhatsApp Messages ────────────────────────────────────────────

model WhatsAppMessage {
  id           String    @id @default(cuid())
  businessId   String
  direction    String // outbound | inbound
  status       String    @default("pending") // pending | sent | delivered | read | failed
  phoneNumber  String
  message      String
  templateId   String?
  leadId       String?
  sentBy       String?
  sentByName   String?
  providerRef  String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  sentAt       DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([phoneNumber])
  @@index([leadId])
  @@index([status])
}

// ─── White-Label / Multi-Brand ────────────────────────────────────

model WhiteLabelConfig {
  id            String   @id @default(cuid())
  businessId    String   @unique
  customDomain  String?
  customLogoUrl String?
  primaryColor  String   @default("#1d4ed8")
  accentColor   String   @default("#84cc16")
  appName       String   @default("Danets AI Automation")
  appShortName  String   @default("Danets AI")
  hideBranding  Boolean  @default(false)
  customCss     String?
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── Platform Control (Super Admin) ───────────────────────────────

model PlatformConfig {
  id                 String   @id @default("default")
  platformName       String   @default("Danets AI Automation")
  platformTagline    String   @default("AI-powered business automation")
  supportEmail       String?
  supportPhone       String?
  defaultSignupPlan  String   @default("free")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  emailFromName      String   @default("Danets AI")
  emailFromAddress   String?
  allowPublicSignup  Boolean  @default(true)
  enforcePlatform2fa Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PlatformAnnouncement {
  id        String    @id @default(cuid())
  title     String
  message   String
  severity  String    @default("info") // info | warning | critical
  isActive  Boolean   @default(true)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
  @@index([startsAt])
}

model PlatformFeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  overrides BusinessFeatureFlag[]
}

model BusinessFeatureFlag {
  id         String   @id @default(cuid())
  businessId String
  flagKey    String
  enabled    Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  flag     PlatformFeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([businessId, flagKey])
  @@index([businessId])
  @@index([flagKey])
}

// ─── Platform Admin Auth (dedicated super-admin realm) ───────────

model PlatformAdmin {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String // bcrypt hash
  totpSecret     String? // base32 secret when 2FA enabled
  totpPending    String? // pending secret during setup
  totpEnabled    Boolean  @default(false)
  homeBusinessId String? // audit-log context (Danets internal tenant)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions            PlatformSession[]
  passwordResetTokens PlatformPasswordResetToken[]

  @@index([email])
}

model PlatformSession {
  id              String   @id @default(cuid())
  token           String   @unique
  platformAdminId String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([platformAdminId])
}

model PlatformPasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

// ─── Public Website CMS ───────────────────────────────────────────
//
// Powers the public marketing site (home, features, pricing, blog,
// docs, changelog, legal). Pages and posts are block-based so marketing
// can compose the site without redeploying. Edited from the super-admin
// console at /platform/cms. Single-tenant for now; the CmsSite wrapper
// is in place so multi-site / white-label publishing can be added later.

model CmsSite {
  id           String   @id @default(cuid())
  // Single-row table for now; multi-site ready (per-domain white-label).
  domain       String?  @unique
  brandName    String   @default("Danets AI Automation")
  tagline      String?
  description  String?
  supportEmail String?
  logoUrl      String?
  faviconUrl   String?
  primaryColor String   @default("#1d4ed8")
  accentColor  String   @default("#84cc16")
  socialLinks  Json? // { twitter, linkedin, github, facebook, instagram }
  seoDefaults  Json? // { title, description, ogImage }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pages     CmsPage[]
  posts     CmsPost[]
  navItems  CmsNavItem[]
  blocks    CmsBlock[]
  media     CmsMedia[]
  authors   CmsAuthor[]
  tags      CmsTag[]
  changelog CmsChangelogEntry[]
}

model CmsPage {
  id          String    @id @default(cuid())
  slug        String    @unique // e.g. "features", "pricing", "about"
  title       String
  description String?
  ogImage     String?
  status      String    @default("draft") // draft | published | archived
  publishedAt DateTime?
  // Body is an ordered list of { blockId | blockKey, props } entries.
  // Stored as JSON so the editor can reorder/insert without migrations.
  blocks      Json      @default("[]")
  // Per-page overrides for { title, description, canonical, noindex, ogImage }.
  seo         Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  siteId String?
  site   CmsSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model CmsPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  coverImage  String?
  bodyMdx     String    @default("") // MDX source rendered with @mdxeditor/editor
  status      String    @default("draft") // draft | published | archived
  publishedAt DateTime?
  seo         Json?
  authorId    String?
  siteId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author CmsAuthor? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  site   CmsSite?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  tags   CmsTag[]   @relation("PostTags")

  @@index([status, publishedAt])
}

model CmsAuthor {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  avatarUrl String?
  twitter   String?
  linkedin  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteId String?
  site   CmsSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  posts CmsPost[]
}

model CmsTag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  siteId String?
  site   CmsSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  posts CmsPost[] @relation("PostTags")
}

model CmsNavItem {
  id        String   @id @default(cuid())
  parentId  String?
  label     String
  href      String // /pricing, /blog, https://...
  order     Int      @default(0)
  visible   Boolean  @default(true)
  icon      String? // lucide icon name for the mega-menu
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   CmsNavItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children CmsNavItem[] @relation("NavTree")
  siteId   String?
  site     CmsSite?     @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([siteId, order])
}

model CmsBlock {
  id           String   @id @default(cuid())
  key          String   @unique // "hero", "feature-grid", "testimonials", ...
  label        String
  description  String?
  // Zod-like schema describing the editable fields, used to generate
  // the admin form. Stored as JSON so we can evolve block schemas
  // without migrations.
  schema       Json
  defaultProps Json     @default("{}")
  icon         String? // lucide icon name
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  siteId String?
  site   CmsSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
}

model CmsMedia {
  id         String   @id @default(cuid())
  filename   String
  mimeType   String
  sizeBytes  Int
  url        String
  altText    String?
  width      Int?
  height     Int?
  storageKey String? // local /uploads path or CDN key
  uploadedBy String? // userId
  createdAt  DateTime @default(now())

  siteId String?
  site   CmsSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
}

model CmsChangelogEntry {
  id          String   @id @default(cuid())
  version     String // e.g. "2024.05.0"
  title       String
  body        String // markdown
  kind        String   @default("release") // release | improvement | fix | security
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  siteId String?
  site   CmsSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
}

// ─── Public Site Contacts ─────────────────────────────────────────
//
// Submissions from the public /contact form land directly in the
// existing Lead model so the existing CRM dashboard picks them up.
// This view mirrors what marketing wants to see in the CMS console.

model CmsContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  pageSlug  String? // where the form was submitted from
  leadId    String? // linked to existing Lead if accepted
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Background jobs ──────────────────────────────────────────────
// MySQL-backed queue (src/lib/jobs). Workers claim rows with
// SELECT ... FOR UPDATE SKIP LOCKED, so several workers can run safely.

model Job {
  id          String    @id @default(cuid())
  businessId  String? // tenant the job acts for; null for platform jobs
  type        String // registered job type, e.g. "system.purge-jobs"
  payload     Json
  status      String    @default("queued") // queued | running | succeeded | dead
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?   @db.Text
  // Idempotent enqueue: a second enqueue with the same key returns the
  // existing row. Recurring schedules use "sched:<type>:<window start>".
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@index([status, runAt])
  @@index([status, lockedAt])
  @@index([businessId])
  @@index([type])
}

// ─── Contacts + attribution (Phase 0, workstream D) ──────────────────
// One person per tenant, unified across chat, leads, tickets and quotes.
// Resolved by any identity (email, phone, widget visitor id, social ids);
// see src/lib/contacts.ts.
model Contact {
  id          String   @id @default(cuid())
  businessId  String
  name        String?
  email       String? // lowercased
  phone       String? // normalised: leading + and digits
  company     String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  consent     Json? // { marketingEmail, whatsapp, sms: { granted, at, source } }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  identities     ContactIdentity[]
  touchpoints    Touchpoint[]
  leads          Lead[]
  chatSessions   ChatSession[]
  supportTickets SupportTicket[]
  quoteRequests  QuoteRequest[]

  @@unique([businessId, email])
  @@index([businessId, phone])
  @@index([businessId, lastSeenAt])
}

model ContactIdentity {
  id         String   @id @default(cuid())
  businessId String
  contactId  String
  type       String // visitor | email | phone | whatsapp | fb_psid | ig_id | linkedin
  value      String   @db.VarChar(191)
  createdAt  DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([businessId, type, value])
  @@index([contactId])
}

// One marketing touch: a site visit (once per browser session), chat start,
// form submit, ad lead, social DM or email click.
model Touchpoint {
  id          String   @id @default(cuid())
  businessId  String
  contactId   String?
  visitorId   String?  @db.VarChar(191)
  kind        String // visit | chat_start | form_submit | ad_lead | social_dm | email_click
  channel     String // organic_search | paid_search | social_organic | social_paid | email | referral | direct | whatsapp
  source      String? // utm_source / referrer host / platform
  medium      String?
  campaign    String?
  term        String?
  content     String?
  clickId     String?  @db.VarChar(500) // value of gclid | fbclid | li_fat_id | msclkid | …
  clickIdType String? // which click-id parameter it came from
  landingUrl  String?  @db.Text // origin + path only (query stripped)
  referrer    String?  @db.Text // origin + path only
  dedupeKey   String?  @unique @db.VarChar(191) // e.g. one visit per browser session
  occurredAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([businessId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([businessId, visitorId])
}

// ─── Brand Voice (Phase 0, workstream E) ─────────────────────────────
// One per tenant. Fed to every AI content generator through
// buildBrandContext() in src/lib/brand.ts.
model BrandProfile {
  id               String    @id @default(cuid())
  businessId       String    @unique
  summary          String?   @db.Text // one-paragraph who-we-are
  audience         Json? // [{ segment, pains: [], desires: [] }]
  tone             Json? // { adjectives: [], formality: 1-5, emoji: bool }
  valueProps       Json? // string[]
  offers           Json? // [{ name, price?, cta, url? }]
  doPhrases        Json? // string[]
  dontPhrases      Json? // string[]
  locales          Json? // ["en-NG", "fr"]
  websiteUrl       String?   @db.VarChar(500)
  source           String    @default("manual") // manual | generated | edited
  generatedAt      DateTime?
  // AI generation runs on the job queue; the UI polls these.
  generationStatus String    @default("idle") // idle | queued | running | failed
  generationError  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── Social accounts (Phase 1, workstream F) ─────────────────────────
// One publishable / inbox-able asset (Facebook Page, Instagram business
// account, LinkedIn Page) reached through an OAuthConnection. Webhooks are
// routed by (platform, externalId), so an asset belongs to one tenant.
model SocialAccount {
  id               String    @id @default(cuid())
  businessId       String
  connectionId     String
  platform         String // facebook_page | instagram | linkedin_page
  externalId       String    @db.VarChar(191) // Page id / IG business account id / LinkedIn org URN
  parentExternalId String?   @db.VarChar(191) // IG: the Facebook Page it is linked to
  name             String
  username         String?
  pictureUrl       String?   @db.Text
  tasks            Json? // Meta Page roles granted to the user (MANAGE, CREATE_CONTENT, MODERATE, ...)
  accessToken      Json? // encrypted envelope (Meta page token); null = use the connection's token
  inboxEnabled     Boolean   @default(false)
  leadSyncEnabled  Boolean   @default(false)
  publishEnabled   Boolean   @default(true)
  autoReply        String    @default("off") // off | suggest | auto
  subscribedAt     DateTime?
  status           String    @default("active") // active | revoked | error
  lastError        String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connection OAuthConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  leadForms  MetaLeadForm[]
  sessions   ChatSession[]

  @@unique([platform, externalId])
  @@index([businessId])
  @@index([connectionId])
}

// Meta "data deletion callback" requests (required for App Review).
// Looked up by confirmation code on the public status page.
model MetaDataDeletionRequest {
  id          String    @id @default(cuid())
  code        String    @unique @db.VarChar(64)
  metaUserId  String    @db.VarChar(191)
  status      String    @default("pending") // pending | completed
  deleted     Json? // counts of what was removed
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([metaUserId])
}

// A Meta Lead Ads form on a connected Page. Created when the poller lists the
// Page's forms or a lead arrives from an unknown form.
model MetaLeadForm {
  id              String    @id @default(cuid())
  businessId      String
  socialAccountId String
  formId          String    @db.VarChar(191)
  name            String
  metaStatus      String? // ACTIVE | ARCHIVED | DELETED | DRAFT (Meta's status)
  enabled         Boolean   @default(true) // import leads from this form
  questions       Json? // [{ key, label, type }] from Meta
  fieldMapping    Json? // { [questionKey]: "name" | "email" | "phone" | "company" | "service" | "message" | "ignore" }
  leadsImported   Int       @default(0)
  lastLeadAt      DateTime?
  // Poll cursor: leads created after this were already requested.
  polledThrough   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, formId])
  @@index([businessId])
}

// Media library (Phase 1 I): images and videos for posts. Files live in
// object storage (or local disk in dev); this row is the index.
model MediaAsset {
  id           String   @id @default(cuid())
  businessId   String
  kind         String // image | video
  storageKey   String   @unique @db.VarChar(191)
  url          String   @db.Text // public URL (Meta and LinkedIn fetch from it)
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?  @db.Text
  originalName String?
  source       String   @default("upload") // upload | ai_generated | stock
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
