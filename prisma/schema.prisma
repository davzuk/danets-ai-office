// Danets AI Automation - Multi-tenant SaaS schema
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenancy & Auth ────────────────────────────────────────────────

model Business {
  id            String   @id @default(cuid())
  name          String
  publicKey     String   @unique @default(cuid())
  industry      String?
  email         String?
  phone         String?
  whatsapp      String?
  plan          String   @default("free") // free | starter | pro | enterprise
  status        String   @default("active") // active | suspended
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users              BusinessUser[]
  aiAgents           AiAgent[]
  knowledgeBaseItems KnowledgeBaseItem[]
  chatSessions       ChatSession[]
  leads              Lead[]
  promptTemplates    AiPromptTemplate[]
  quoteRequests      QuoteRequest[]
  generatedDocuments GeneratedDocument[]
  usageLogs          AiUsageLog[]
  sessions           Session[]
  ticketCategories   SupportTicketCategory[]
  supportTickets     SupportTicket[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  documents          Document[]
  whatsappTemplates  WhatsAppTemplate[]
  whatsappIntegration WhatsAppIntegration[]
}

model BusinessUser {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String   @unique
  password   String // bcrypt hash
  role       String   @default("admin") // admin | member
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions  Session[]

  @@index([businessId])
}

model Session {
  id              String   @id @default(cuid())
  token           String   @unique
  businessUserId  String
  businessId      String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  businessUser BusinessUser @relation(fields: [businessUserId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([token])
}

// ─── AI Configuration ──────────────────────────────────────────────

model AiAgent {
  id              String   @id @default(cuid())
  businessId      String
  botName         String   @default("Assistant")
  businessName    String?
  industry        String?
  welcomeMessage  String   @default("Hi! How can I help you today?")
  fallbackMessage String   @default("I'm not fully sure about that. Please contact our team for confirmation.")
  handoverMessage String   @default("Let me connect you with our team for further assistance.")
  tone            String   @default("professional") // professional | friendly | formal
  contactPhone    String?
  whatsappNumber  String?
  email           String?
  brandColor      String   @default("#1d4ed8")
  quickReplies    String   @default("[]") // JSON array of suggested question strings
  status          String   @default("active") // active | inactive
  leadCaptureEnabled Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chatSessions  ChatSession[]

  @@index([businessId])
}

model KnowledgeBaseItem {
  id         String   @id @default(cuid())
  businessId String
  title      String
  content    String
  category   String   @default("General")
  sourceType String   @default("manual") // manual | faq | doc | url
  status     String   @default("active") // active | draft | archived
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
}

model AiPromptTemplate {
  id         String   @id @default(cuid())
  businessId String
  name       String
  type       String   @default("custom") // chat_system | suggested_reply | quote | summary | custom
  content    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ─── Chat & Leads ──────────────────────────────────────────────────

model ChatSession {
  id           String   @id @default(cuid())
  businessId   String
  agentId      String?
  visitorName  String?
  visitorEmail String?
  visitorPhone String?
  visitorId    String?  // anonymous browser id
  status       String   @default("active") // active | ended | handover
  summary      String?
  leadQuality  String?  // low | medium | high
  nextAction   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agent    AiAgent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
  lead     Lead?
  supportTickets SupportTicket[]

  @@index([businessId])
  @@index([status])
}

model ChatMessage {
  id         String   @id @default(cuid())
  sessionId  String
  role       String   // user | assistant | system
  content    String
  tokensUsed Int      @default(0)
  meta       String?  // JSON string for extra data
  createdAt  DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Lead {
  id                String   @id @default(cuid())
  businessId        String
  sessionId         String?  @unique
  name              String
  email             String?
  phone             String?
  service           String?
  message           String?
  quality           String   @default("medium") // low | medium | high
  status            String   @default("new") // new | contacted | qualified | proposal_sent | negotiation | won | lost
  source            String   @default("chatbot") // chatbot | website_form | manual | whatsapp | referral | social_media
  // CRM fields
  dealValue         Float    @default(0)
  leadScore         Int      @default(0) // 0-100
  expectedCloseDate DateTime?
  assignedTo        String?  // BusinessUser id
  company           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  session   ChatSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  notes     LeadNote[]
  tasks     LeadTask[]
  activities LeadActivity[]

  @@index([businessId])
  @@index([status])
  @@index([assignedTo])
}

// ─── CRM: Lead Notes, Tasks, Activities ───────────────────────────

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  businessId String
  authorId  String?  // BusinessUser id
  authorName String
  content   String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([businessId])
}

model LeadTask {
  id          String   @id @default(cuid())
  leadId      String
  businessId  String
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  completedAt DateTime?
  assigneeId  String?  // BusinessUser id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([businessId])
  @@index([completed])
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  businessId  String
  type        String   // status_change | note_added | task_created | task_completed | lead_created | lead_updated | call | email | whatsapp
  description String
  metadata    String?  // JSON string for extra context
  actorId     String?  // BusinessUser id (null for system)
  actorName   String?
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([businessId])
  @@index([type])
}

// ─── Support Tickets ───────────────────────────────────────────────

model SupportTicketCategory {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  color       String   @default("#1d4ed8")
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tickets  SupportTicket[]

  @@index([businessId])
}

model SupportTicket {
  id          String   @id @default(cuid())
  businessId  String
  categoryId  String?
  chatSessionId String? // link to chat session if converted from chat
  subject     String
  description String
  status      String   @default("open") // open | pending | in_progress | resolved | closed
  priority    String   @default("medium") // low | medium | high | urgent
  // AI-detected fields
  aiSummary   String?
  aiPriority  String?  // low | medium | high | urgent
  aiSentiment String?  // positive | neutral | negative | frustrated
  aiNextAction String?
  // Customer info
  customerName  String?
  customerEmail String?
  customerPhone String?
  // Assignment
  assignedTo  String?  // BusinessUser id
  assignedName String?
  // AI suggested reply (stored for review, not auto-sent)
  aiSuggestedReply String?
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?

  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    SupportTicketCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  chatSession ChatSession?           @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  messages    SupportTicketMessage[]
  notes       SupportTicketNote[]

  @@index([businessId])
  @@index([status])
  @@index([priority])
}

model SupportTicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  role        String   // customer | agent | system
  content     String
  authorId    String?  // BusinessUser id (for agent messages)
  authorName  String?
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SupportTicketNote {
  id          String   @id @default(cuid())
  ticketId    String
  businessId  String
  authorId    String?
  authorName  String
  content     String
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([businessId])
}

// ─── Usage & Documents ─────────────────────────────────────────────

model AiUsageLog {
  id         String   @id @default(cuid())
  businessId String
  feature    String   // chat | suggested_reply | quote | summary
  promptTokens  Int   @default(0)
  completionTokens Int @default(0)
  totalTokens   Int   @default(0)
  costUsd     Float    @default(0)
  status      String   @default("success") // success | error
  error       String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([feature])
}

model QuoteRequest {
  id           String   @id @default(cuid())
  businessId   String
  clientName   String
  companyName  String?
  service      String
  requirements String
  budgetRange  String?
  timeline     String?
  notes        String?
  status       String   @default("draft") // draft | generated | sent
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documents GeneratedDocument[]

  @@index([businessId])
}

model GeneratedDocument {
  id            String   @id @default(cuid())
  businessId    String
  quoteRequestId String?
  type          String   @default("proposal") // proposal | summary | quote
  title         String
  content       String
  createdAt     DateTime @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)

  @@index([businessId])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  priceUsd    Float    @default(0)
  chatLimit   Int      @default(100)
  leadLimit   Int      @default(50)
  kbLimit     Int      @default(25)
  features    String   @default("[]") // JSON array
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Notifications ─────────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  businessId  String
  userId      String?   // targeted user (null = all business users)
  type        String    // new_lead | new_ticket | urgent_ticket | proposal_generated | proposal_accepted | follow_up_reminder | high_quality_lead | ai_usage_warning | subscription_expiry | integration_failed | new_chat_session
  title       String
  message     String
  data        String?   // JSON string for extra context (leadId, ticketId, etc.)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([type])
  @@index([readAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  businessId  String
  userId      String?
  userName    String?
  action      String   // login | user_created | user_updated | user_deleted | business_settings_changed | ai_agent_updated | kb_updated | lead_status_changed | proposal_generated | ticket_updated | document_uploaded | integration_changed | subscription_changed
  module      String   // auth | team | business | agent | knowledge | leads | quotes | tickets | documents | integrations | subscription
  description String
  ipAddress   String?
  userAgent   String?
  metadata    String?  // JSON string for extra context
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([action])
  @@index([module])
}

model NotificationPreference {
  id          String   @id @default(cuid())
  businessId  String
  userId      String
  type        String   // matches Notification.type
  inApp       Boolean  @default(true)
  email       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, userId, type])
  @@index([businessId, userId])
}

// ─── AI Document Assistant ────────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  businessId  String
  title       String
  category    String   @default("General")
  sourceType  String   @default("text") // text | pdf | docx | txt
  content     String   // full text content (for text-based docs) or extracted text
  fileName    String?  // original file name if uploaded
  fileSize    Int?     // bytes
  summary     String?  // AI-generated summary
  status      String   @default("active") // active | processing | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chunks   DocumentChunk[]
  questions DocumentAiQuestion[]

  @@index([businessId])
  @@index([status])
}

model DocumentChunk {
  id          String   @id @default(cuid())
  documentId  String
  content     String
  chunkIndex  Int
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentAiQuestion {
  id          String   @id @default(cuid())
  documentId  String
  businessId  String
  question    String
  answer      String?
  tokensUsed  Int      @default(0)
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([businessId])
}

// ─── WhatsApp Automation ──────────────────────────────────────────

model WhatsAppTemplate {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  type        String   // new_lead_followup | missed_chat | quotation_followup | payment_reminder | appointment_confirmation | ticket_update | custom
  content     String   // template text with {name}, {service}, {company} placeholders
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([type])
}

model WhatsAppIntegration {
  id          String   @id @default(cuid())
  businessId  String
  provider    String   @default("manual") // manual | meta_cloud_api | twilio | termii | other
  phoneNumber String?
  phoneNumberId String? // Meta Cloud API phone number ID
  apiKey      String?  // stored server-side only, never exposed to frontend
  webhookUrl  String?
  status      String   @default("inactive") // active | inactive | testing
  lastTestedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

