# ─── Database (required) ───────────────────────────────────────────
DATABASE_URL="mysql://root@localhost:3306/danets_ai"

# ─── App ───────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL for payment callbacks (required in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Tenant websites live on <subdomain>.SITES_DOMAIN. Use a registrable domain
# separate from the app's (e.g. danets.site next to app.danets.com) with a
# wildcard DNS record. Unset: tenant sites are off in production; development
# uses <subdomain>.localhost:<port> from NEXT_PUBLIC_APP_URL.
# SITES_DOMAIN=danets.site
# Other hostnames that serve the app itself (comma-separated), e.g. the
# marketing domain. Any hostname that isn't the app's or under SITES_DOMAIN
# is treated as a tenant's custom domain.
# APP_HOSTS=danets.com,www.danets.com
# DNS servers for custom-domain checks (default: the system resolver).
# SITES_DNS_SERVERS=1.1.1.1,8.8.8.8

# 32 random bytes, base64-encoded. Required in production; in dev a fixed
# fallback is used so the codebase still boots without setup. Generate with:
#   openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# ─── AI ────────────────────────────────────────────────────────────
# Platform default provider (tenants can override in Integrations → AI provider).
# anthropic | openai | zai. Unset: anthropic if ANTHROPIC_API_KEY is set, else zai.
AI_DEFAULT_PROVIDER=
ANTHROPIC_API_KEY=
# Optional model overrides (default for every task: claude-opus-5-5).
# AI_DEFAULT_MODEL applies to all tasks; AI_MODEL_<TASK> wins for one task
# (tasks: CHAT, CLASSIFY, EXTRACT, CONTENT, PLAN).
AI_DEFAULT_MODEL=
# AI_MODEL_CHAT=
# Platform OpenAI fallback — needs both a key and a model.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=

# ─── Email ─────────────────────────────────────────────────────────
# smtp | sendgrid | none (default: none — logs only)
EMAIL_PROVIDER=none
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@danetstecpro.com
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@danetstecpro.com

# ─── Payments ──────────────────────────────────────────────────────
# Default checkout currency (NGN recommended for Paystack/Flutterwave)
PAYMENT_CURRENCY=NGN
# USD → NGN conversion when plan prices are stored in USD
PAYMENT_USD_NGN_RATE=1600

# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave (https://flutterwave.com)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=

# ─── WhatsApp (Meta Cloud API) ─────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=

# ─── Rate limiting (optional — multi-instance production) ──────────
# When set, login/chat/lead rate limits use Redis instead of in-memory
REDIS_URL=

# Bearer token for scheduled jobs (e.g. retention cron)
CRON_SECRET=
# Background job worker (npm run worker)
JOB_CONCURRENCY=4
JOB_POLL_MS=2000

# ─── Connected accounts (OAuth) ────────────────────────────────────
# Register these redirect URIs with each provider:
#   {NEXT_PUBLIC_APP_URL}/api/connections/meta/callback
#   {NEXT_PUBLIC_APP_URL}/api/connections/google/callback
#   {NEXT_PUBLIC_APP_URL}/api/connections/linkedin/callback
# Meta (Facebook Pages, Instagram, Lead Ads). Leave blank to hide "Connect".
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
# Optional comma-separated override of the requested permissions
META_OAUTH_SCOPES=
# Webhook endpoint: {NEXT_PUBLIC_APP_URL}/api/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=
# Google (Search Console, Business Profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional space-separated override of the requested scopes
GOOGLE_OAUTH_SCOPES=
# LinkedIn (Page publishing, Lead Gen Forms). Leave blank to hide "Connect".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Versioned API month (YYYYMM); LinkedIn retires versions after about a year
LINKEDIN_API_VERSION=202610
# true once the Lead Sync API is approved: adds r_marketing_leadgen_automation
LINKEDIN_LEAD_SYNC=false
# Optional space-separated override of the requested scopes
LINKEDIN_OAUTH_SCOPES=

# Media library storage: local (single server) or s3 (R2, S3, Spaces, MinIO). See DEPLOYMENT.md.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./storage/media
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.example.com
# S3_REGION=auto
